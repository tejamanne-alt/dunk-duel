<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Developer CLI for the headless sim:
      hash     regenerate Assets/DunkDuel/Sim/Core/SimBuildInfo.g.cs (sim code hash)
      golden   regenerate the 10,000-frame determinism replay and its golden hash
      trace    run a CPU match and print the event log
      replay   verify a replay file
  -->
  <Import Project="..\..\Headless\Directory.Build.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DunkDuel.SimTool</AssemblyName>
    <RootNamespace>DunkDuel.Tools</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Headless\src\DunkDuel.Sim\DunkDuel.Sim.csproj" />
    <ProjectReference Include="..\..\Headless\src\DunkDuel.AI\DunkDuel.AI.csproj" />
  </ItemGroup>
</Project>
