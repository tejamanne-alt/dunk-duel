<Project Sdk="Microsoft.NET.Sdk">
  <!-- CPU opponents. Sources: Assets/DunkDuel/AI (shared with Unity). Depends on Sim only. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DunkDuel.AI</AssemblyName>
    <RootNamespace>DunkDuel.AI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnitySrc)AI\**\*.cs" LinkBase="AI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DunkDuel.Sim\DunkDuel.Sim.csproj" />
  </ItemGroup>
</Project>
